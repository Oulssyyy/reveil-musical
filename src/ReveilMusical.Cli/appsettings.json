{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http": "Warning"
    }
  },
  "Music": {
    "ProviderOrder": [ "itunes", "musicbrainz" ],
    "Cache": { "TimeToLive": "12:00:00" },
    "Itunes": {
      "BaseUrl": "https://itunes.apple.com/",
      "Limit": 5,
      "Timeout": "00:00:03",
      "MaxRequestsPerMinute": 20
    },
    "MusicBrainz": {
      "BaseUrl": "https://musicbrainz.org/ws/2/",
      "Timeout": "00:00:03",
      "ApplicationName": "ReveilMusical",
      "ApplicationVersion": "1.0",
      "Contact": "contact@reveil-musical.example",
      "MaxRequestsPerMinute": 50
    }
  },
  "Notifications": {
    "FallbackOrder": [ "push", "sms", "email" ],
    "Fakes": {
      "EmailOutage": false,
      "SmsOutage": false,
      "PushOutage": false
    }
  }
}
